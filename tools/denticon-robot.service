[Unit]
Description=Denticon report robot window (standing Chrome; log in when it asks; pulls go to data/inbox)
After=graphical-session.target

[Service]
WorkingDirectory=%h/Monthly-report
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/node %h/Monthly-report/tools/denticon_robot.js serve
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
